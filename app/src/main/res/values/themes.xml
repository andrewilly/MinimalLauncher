<resources>
    <!--
        Base theme for the launcher home screen.
        MUST extend Theme.AppCompat (not android:Theme.Material) because
        all Activities extend AppCompatActivity.

        We make the background transparent so the device wallpaper shows through.
    -->
    <style name="Theme.MinimalLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- Transparent variant used for dark/wallpaper mode -->
    <style name="Theme.MinimalLauncher.Transparent">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- App Drawer theme -->
    <style name="Theme.MinimalLauncher.Drawer" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/drawer_background</item>
        <item name="android:windowAnimationStyle">@style/DrawerAnimation</item>
    </style>

    <!-- Settings theme -->
    <style name="Theme.MinimalLauncher.Settings" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/settings_background</item>
    </style>

    <!-- Drawer slide animation -->
    <style name="DrawerAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
