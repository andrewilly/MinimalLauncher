<resources>
    <!-- Base application theme (minimal, transparent, no action bar) -->
    <style name="Theme.MinimalLauncher" parent="android:Theme.Material.Wallpaper.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- App Drawer theme -->
    <style name="Theme.MinimalLauncher.Drawer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/drawer_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@style/DrawerAnimation</item>
    </style>

    <!-- Settings theme -->
    <style name="Theme.MinimalLauncher.Settings" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <!-- Drawer slide animation -->
    <style name="DrawerAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
