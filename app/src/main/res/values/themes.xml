<resources>
    <!--
        Base application theme for the launcher home screen.
        Uses Theme.Material.Wallpaper (exists in SDK) which provides:
        - Transparent background showing the device wallpaper
        - Translucent status bar and navigation bar
        We manually remove the action bar via windowNoTitle.
    -->
    <style name="Theme.MinimalLauncher" parent="android:Theme.Material.Wallpaper">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- App Drawer theme -->
    <style name="Theme.MinimalLauncher.Drawer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/drawer_background</item>
        <item name="android:windowAnimationStyle">@style/DrawerAnimation</item>
    </style>

    <!-- Settings theme -->
    <style name="Theme.MinimalLauncher.Settings" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/settings_background</item>
    </style>

    <!-- Drawer slide animation -->
    <style name="DrawerAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
