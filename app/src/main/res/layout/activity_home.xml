<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- ===== MAIN: Clock + Date + Battery + App Names ===== -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Clock - molto grande stile Olauncher -->
        <TextView
            android:id="@+id/text_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="sans-serif-thin"
            android:textColor="@color/text_primary"
            android:textSize="96sp"
            android:letterSpacing="0.02" />

        <!-- Date + Battery row -->
        <LinearLayout
            android:id="@+id/date_battery_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Separator dot -->
            <TextView
                android:id="@+id/text_date_battery_sep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="sans-serif-light"
                android:text="\u2022"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Battery percentage -->
            <TextView
                android:id="@+id/text_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- App names list (Olauncher style) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_home_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:paddingBottom="80dp" />

    </LinearLayout>

    <!-- ===== BOTTOM: Settings (long press) ===== -->
    <View
        android:id="@+id/settings_touch_area"
        android:layout_width="80dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
